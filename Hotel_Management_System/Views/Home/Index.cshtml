@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"]</title>
</head>
<body>

    <h2>Welcome to Hyatt Hotel</h2>
    <h3>Dear Guest, Please book now. Before booking please see the rooms below</h3>

    <div class="myDiv">
        <img src="/images/Hotel.jpg" alt="Jane">
    </div>

    <div class="card">
        <img src="/images/Delux.jpg" alt="Jane">
        <div class="container">
            <h2>Deluxe Room</h2>
            <a asp-controller="Bookings" asp-action="Create">
                <input type="button" class="btn btn-primary" value="Book Now">
            </a>
        </div>
    </div>

    <div class="card">
        <img src="/images/Delux2.jpg" alt="Jane">
        <div class="container">
            <h2>Deluxe Room</h2>
            <a asp-controller="Bookings" asp-action="Create">
                <input type="button" class="btn btn-primary" value="Book Now">
            </a>
        </div>
    </div>

    <div class="card">
        <img src="/images/Double.jpeg" alt="Jane">
        <div class="container">
            <h2>Double Room</h2>
            <a asp-controller="Bookings" asp-action="Create">
                <input type="button" class="btn btn-primary" value="Book Now">
            </a>
        </div>
    </div>

    <div class="card">
        <img src="/images/Single.jpeg" alt="Jane">
        <div class="container">
            <h2>Single Room</h2>
            <a asp-controller="Bookings" asp-action="Create">
                <input type="button" class="btn btn-primary" value="Book Now">
            </a>
        </div>
    </div>

    <div class="card">
        <img src="/images/Triple.jpg" alt="Jane">
        <div class="container">
            <h2>Triple Room</h2>
            <a asp-controller="Bookings" asp-action="Create">
                <input type="button" class="btn btn-primary" value="Book Now">
            </a>
        </div>
    </div>

    <div class="card">
        <img src="/images/Standard.jpeg" alt="Jane">
        <div class="container">
            <h2>Standard Room</h2>
            <a asp-controller="Bookings" asp-action="Create">
                <input type="button" class="btn btn-primary" value="Book Now">
            </a>
        </div>
    </div>



</body>
</html>
